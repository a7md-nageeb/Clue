<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_root"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/widget_chip_selected"
    android:gravity="center"
    android:minWidth="@dimen/widget_chip_width"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/chip_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="4dp"
        android:importantForAccessibility="no"
        android:tint="@color/widget_accent_on"
        android:visibility="gone" />

    <TextView
        android:id="@+id/chip_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_accent_on"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
